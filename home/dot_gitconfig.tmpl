[credential]
	helper = store
[user]
	name = Nick Price
	email = nick@spun.io
[core]
	excludesfile = ~/.gitignore_global
[pull]
	rebase = true
[init]
	defaultBranch = main
[submodule]
	recurse = true
[push]
	autoSetupRemote = true
[remote "origin"]
	prune = true
{{- if eq .chezmoi.os "darwin" }}
[user]
	signingkey = ssh-rsa 
[gpg]
	format = ssh
[gpg "ssh"]
	program = /Applications/1Password.app/Contents/MacOS/op-ssh-sign
[commit]
	gpgsign = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
{{- else if eq .chezmoi.os "freebsd" }}
[user]
	signingkey = /home/nprice/.ssh/id_rsa.pub
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = /home/nprice/.ssh/allowed_signers
[commit]
	gpgsign = true
[tag]
	gpgsign = true
[safe]
	directory = /usr/src
{{- end }}
# host-local overrides (e.g. work email), not in the repo
[include]
	path = ~/.gitconfig.local
